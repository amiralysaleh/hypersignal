{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hypersignal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "hypersignal", "database_id": "a1346ba1-4968-413a-81d0-ba49779f635a" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AUTOMATION_SCHEDULER", "class_name": "AutomationScheduler" }
    ]
  },
  "migrations": [
    {
      "tag": "20241013_automation_scheduler",
      "new_sqlite_classes": ["AutomationScheduler"]
    }
  ]
}
